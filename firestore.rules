rules_version = '2';
// Solo quien inició sesión con la cuenta del equipo puede leer y escribir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coleccion}/{id} {
      allow read, write: if request.auth != null
        && coleccion in ['songs', 'setlists', 'pdfs', 'pdfchunks', 'live'];
    }
  }
}
